NODE_ENV=development
PORT=4000
# Postgres — connection_limit keeps pool within max_connections per instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp?schema=public&connection_limit=10&pool_timeout=20"
# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# CORS — explicit allowlist, comma separated
CORS_ORIGINS=http://localhost:3000
# Microservices — gateway proxies to each feature service on its own port.
# PORT above is the monolith. These drive the split services (pnpm dev:services).
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
USERS_SERVICE_PORT=4002
CORE_SERVICE_PORT=4003
AUTH_SERVICE_URL=http://localhost:4001
USERS_SERVICE_URL=http://localhost:4002
CORE_SERVICE_URL=http://localhost:4003
