NODE_ENV=production
PORT=4000

# Managed Postgres — Sumobase gives two endpoints, same host, different ports.
# Runtime app traffic goes through the pooler (transaction mode).
# pgbouncer=true tells Prisma to disable prepared statements the pooler can't hold.
DATABASE_URL="postgresql://USER:PASSWORD@pgsql-dbas-jkt1-005.sumobase.my.id:6432/DBNAME?schema=public&connection_limit=10&pool_timeout=20&pgbouncer=true"

# `prisma migrate deploy` (runs on container start) needs a DIRECT, non-pooled
# connection — it takes an advisory lock a transaction-mode pooler can't hold.
# Same host/user/db, direct port instead of the pooler port.
DIRECT_URL="postgresql://USER:PASSWORD@pgsql-dbas-jkt1-005.sumobase.my.id:65436/DBNAME?schema=public"

# Auth — generate each with: openssl rand -base64 48  (use TWO different values)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS — exact frontend origin, comma separated. Never '*' with credentials.
CORS_ORIGINS=https://mini-erp.malvinharis.web.id
