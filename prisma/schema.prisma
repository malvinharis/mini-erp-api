// Base schema — only User + RefreshToken. Domain models added per project.
// Conventions: uuid PK, createdAt/updatedAt on every model, Decimal(14,2) for money,
// soft delete via deletedAt where history matters, index FKs + filter + sort columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // pooled connection (PgBouncer, transaction mode) — used at runtime
  url       = env("DATABASE_URL")
  // direct connection — used only by `prisma migrate deploy`, which needs an
  // advisory lock that a transaction-mode pooler can't hold
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String
  role      UserRole  @default(STAFF)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens        RefreshToken[]
  createdInvoices      Invoice[]          @relation("InvoiceCreatedBy")
  invoiceStatusChanges InvoiceStatusLog[] @relation("InvoiceStatusChangedBy")

  @@index([email])
  @@index([role, createdAt])
}

// Org-wide customer records (shared across staff). Soft delete keeps history
// for the invoices that will reference them.
model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  npwp      String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoices Invoice[]

  @@index([name])
  @@index([email])
  @@index([createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// Invoice header. Derived money columns (subtotal/taxAmount/total) are stored,
// computed server-side from the items — never trusted from the client.
model Invoice {
  id          String        @id @default(uuid())
  number      String        @unique
  customerId  String
  createdById String
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime
  dueDate     DateTime
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  taxRate     Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(14, 2)
  total       Decimal       @default(0) @db.Decimal(14, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer   Customer           @relation(fields: [customerId], references: [id])
  createdBy  User               @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items      InvoiceItem[]
  statusLogs InvoiceStatusLog[]

  @@index([customerId])
  @@index([status, issueDate])
  @@index([issueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Audit timeline — who changed the status, when, from and to.
model InvoiceStatusLog {
  id          String         @id @default(uuid())
  invoiceId   String
  fromStatus  InvoiceStatus?
  toStatus    InvoiceStatus
  changedById String
  createdAt   DateTime       @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy User    @relation("InvoiceStatusChangedBy", fields: [changedById], references: [id])

  @@index([invoiceId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}
