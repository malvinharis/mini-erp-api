// Base schema — only User + RefreshToken. Domain models added per project.
// Conventions: uuid PK, createdAt/updatedAt on every model, Decimal(14,2) for money,
// soft delete via deletedAt where history matters, index FKs + filter + sort columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // pooled connection (PgBouncer, transaction mode) — used at runtime
  url       = env("DATABASE_URL")
  // direct connection — used only by `prisma migrate deploy`, which needs an
  // advisory lock that a transaction-mode pooler can't hold
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String
  role      UserRole  @default(STAFF)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens RefreshToken[]

  @@index([email])
  @@index([role, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}
